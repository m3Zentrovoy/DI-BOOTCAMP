    <worksheet name='Cost vs. Efficiency'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#1f1f1f'>Top-left:</run>
            <run fontcolor='#1f1f1f'> Expensive but slow-moving products.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1f1f1f'>Bottom-right:</run>
            <run fontcolor='#1f1f1f'> Cheap and fast-moving products (favored!).</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders+ (Acropolis_Retail_data_update)' name='federated.1acszzh1e4j9p011092rb0tktlq8' />
