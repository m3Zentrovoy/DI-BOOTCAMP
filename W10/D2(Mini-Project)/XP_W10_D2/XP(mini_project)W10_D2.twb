      <activation type='on-select' />
      <source dashboard='Data Job Market Insights – Trends, Skills &amp; Opportunities' type='sheet' worksheet='Relevant Data Job Postings' />
      <link caption='Job Category' delimiter=',' escape='\' expression='tsl:Data%20Job%20Market%20Insights%20%E2%80%93%20Trends%2C%20Skills%20%26%20Opportunities?' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Relevant Data Job Postings' />
        <param name='target' value='Data Job Market Insights – Trends, Skills &amp; Opportunities' />
      </command>
    </action>
