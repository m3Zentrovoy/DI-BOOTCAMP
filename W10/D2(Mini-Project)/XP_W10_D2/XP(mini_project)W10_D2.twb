      <link caption='Filter by month' delimiter=',' escape='\' expression='tsl:Data%20Job%20Market%20Insights%20%E2%80%93%20Trends%2C%20Skills%20%26%20Opportunities?%5Bfederated.1r9pxik0n1urr917hacfc0pnc1tu%5D.%5BCalculation_4041699254987132929%5D~s0=&lt;[federated.1r9pxik0n1urr917hacfc0pnc1tu].[Calculation_4041699254987132929]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
