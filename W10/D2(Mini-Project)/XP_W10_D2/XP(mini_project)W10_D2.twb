      <column caption='Clean Job Title' datatype='string' name='[Calculation_4041699254987132929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Job Title]), &quot;analyst&quot;) &#13;&#10;OR CONTAINS(LOWER([Job Title]), &quot;analytics&quot;) THEN &quot;Data Analyst&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Title]), &quot;scientist&quot;) &#13;&#10;OR CONTAINS(LOWER([Job Title]), &quot;science&quot;) THEN &quot;Data Scientist&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Title]), &quot;engineer&quot;) THEN &quot;Data Engineer&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Title]), &quot;machine learning&quot;) THEN &quot;ML Engineer&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Percent of Total' datatype='real' name='[Calculation_4041699254989295618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[Sheet1_2D6384446B6F4C259CE08F0EB1B2B4CD])/TOTAL(COUNT([__tableau_internal_object_id__].[Sheet1_2D6384446B6F4C259CE08F0EB1B2B4CD]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Skill Identified' datatype='string' name='[Calculation_4041699255002251267]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Job Skills]), &quot;python&quot;) THEN &quot;Python&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;agile&quot;) THEN &quot;Agile&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;sql&quot;) THEN &quot;SQL&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;excel&quot;) THEN &quot;Excel&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;power_bi&quot;) THEN &quot;Power BI&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;tableau&quot;) THEN &quot;Tableau&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;r&quot;) THEN &quot;R&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;aws&quot;) &#13;&#10;OR CONTAINS(LOWER([Job Skills]), &quot;cloud&quot;) THEN &quot;Cloud&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;ml&quot;)&#13;&#10;OR CONTAINS(LOWER([Job Skills]), &quot;machine_learning&quot;) THEN &quot;Machine Learning&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;database&quot;) THEN &quot;DataBase&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;programming&quot;) THEN &quot;Programming&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;microsoft&quot;) THEN &quot;Microsoft&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;spreadsheets&quot;) THEN &quot;Spreadsheets&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Skills]), &quot;c&quot;) THEN &quot;C&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
