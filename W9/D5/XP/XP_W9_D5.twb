      <aliases enabled='yes' />
      <column caption='Profitability Index' datatype='real' name='[Calculation_4452934194960441344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Global_Sales]) - sum([Global_Sales]*0.3))/TOTAL(sum([Global_Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales Performance Index' datatype='integer' name='[Calculation_4452934194966220801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Global_Sales]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YoY Growth Rate' datatype='real' name='[Calculation_4452934194986692610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Global_Sales]) - LOOKUP(SUM([Global_Sales]), -1)) / LOOKUP(SUM([Global_Sales]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Genre Dominance Ratio' datatype='real' name='[Calculation_4452934194988003331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Global_Sales]) / TOTAL(SUM([Global_Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='UE Genre Ratio' datatype='real' name='[Calculation_4452934194994561028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([EU_Sales]) / sum({FIXED : sum([EU_Sales])})' />
      </column>
      <column caption='JP Genre Ratio' datatype='real' name='[Calculation_4452934194995527685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([JP_Sales]) / sum({ FIXED : sum([JP_Sales])})' />
      </column>
      <column caption='NA Genre Ratio' datatype='real' name='[Calculation_4452934194995867654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([NA_Sales])/sum({FIXED : sum([NA_Sales])})' />
      </column>
      <column caption='Other Genre Ratio' datatype='real' name='[Calculation_4452934194996146183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Other_Sales])/sum({FIXED : sum([Other_Sales])})' />
      </column>
      <column aggregation='None' caption='EU Sales (bin)' datatype='integer' name='[EU Sales (bin)]' role='dimension' type='ordinal'>
